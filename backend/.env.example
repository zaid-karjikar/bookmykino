SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Only used by seed.py, and only needed if row-level security is
# enabled on the showtimes table (the anon key cannot insert/delete then).
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Caches GET /movies/ results. If unset, defaults to a local Redis
# instance; if Redis is unreachable, requests fall through to the database
# instead of failing.
REDIS_URL=redis://localhost:6379/0
MOVIES_CACHE_TTL_SECONDS=30
